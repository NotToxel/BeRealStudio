{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeReal Studio",
  "version": "2.3.2",
  "identifier": "com.nottoxel.berealstudio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "BeReal Studio",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 780,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Graphics and Design",
    "shortDescription": "BeReal GDPR Archive Explorer & Recap Studio",
    "longDescription": "Desktop application to browse, composite, and recap BeReal GDPR archives",
    "copyright": "Copyright © 2026 NotToxel",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"]
      }
    },
    "macOS": {
      "signingIdentity": null
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libjavascriptcoregtk-4.1-0", "libsoup-3.0-0"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
